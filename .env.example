# Password-free, isolated sample workspace for MVP testing. Set false for team-only sign-in.
DEMO_LOGIN=true
DATABASE_URL=sqlite://.local/blaubeere.db
API_BIND=127.0.0.1:8080
API_ORIGIN=http://localhost:8080
API_INTERNAL_URL=http://127.0.0.1:8080
APP_ORIGIN=http://localhost:3100
MCP_BIND=127.0.0.1:8081
MCP_RESOURCE=http://localhost:8081/mcp
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_LANDING_URL=http://localhost:3102
# Optional shared assessment snapshot; defaults to the labelled synthetic fixture.
# ASSESSMENT_FILE=/absolute/path/to/companies.json
# Set these once to provision an authorised account. Never commit a real password.
BOOTSTRAP_EMAIL=finance@blaubeere.local
BOOTSTRAP_PASSWORD=
BOOTSTRAP_COMPANIES=DEMO_001
